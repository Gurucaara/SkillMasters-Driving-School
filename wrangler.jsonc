{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-23",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "skillmasters-driving-school",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Contact form settings (not secret). Secrets are set with `npx wrangler secret put <NAME>`:
	// TURNSTILE_SECRET_KEY, RESEND_API_KEY. See .dev.vars.example for local testing.
	"vars": {
		"CONTACT_TO": "info@skillmastersdrivingschool.ca",
		"CONTACT_FROM": "Skillmasters Website <website@skillmastersdrivingschool.ca>"
	},
	// At most 5 contact-form messages per minute from one visitor (src/pages/api/contact.ts).
	"ratelimits": [
		{
			"name": "CONTACT_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}