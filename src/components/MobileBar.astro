---
// Quick contact, on every page:
// - md and up: green floating WhatsApp button, bottom-right.
// - below md: Call / WhatsApp / Book bar fixed to the bottom (BaseLayout pads the body so it
//   never covers the footer). Matches the .wa / .mbar elements in docs/mockup/Footer.dc.html.
import { site, cta } from '../data/site';

const barLink = 'flex min-h-12 flex-1 items-center justify-center rounded-[14px] text-[15px] font-bold text-[#F5EFE3]';
---

<a
  href={site.whatsapp}
  aria-label="Chat on WhatsApp"
  rel="noopener"
  target="_blank"
  class="fixed bottom-6 right-6 z-40 hidden size-[60px] items-center justify-center rounded-full bg-[#25D366] text-white shadow-[0_10px_30px_#00000040] transition hover:-translate-y-0.5 md:flex"
>
  <svg aria-hidden="true" class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path d="M21 12a9 9 0 0 1-13.5 7.8L3 21l1.2-4.4A9 9 0 1 1 21 12z" />
    <path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 .8a4 4 0 0 1-1.8-1.8l.8-1-1-2z" fill="currentColor" />
  </svg>
</a>

<nav
  aria-label="Quick actions"
  class="fixed inset-x-3 bottom-[max(12px,env(safe-area-inset-bottom))] z-40 flex gap-2 rounded-[20px] border border-[#2E291F] bg-ink p-2 shadow-[0_12px_30px_#00000059] md:hidden"
>
  <a href={site.phone.href} class={barLink}>Call</a>
  <a href={site.whatsapp} class={barLink} rel="noopener" target="_blank">WhatsApp</a>
  <a href={cta.href} class="flex min-h-12 flex-[1.3] items-center justify-center rounded-[14px] bg-[#E6B33C] text-[15px] font-extrabold text-ink">
    {cta.label}
  </a>
</nav>
