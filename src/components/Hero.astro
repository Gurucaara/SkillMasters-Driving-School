---
// Home hero: headline + intro + CTAs + quick facts on the left, the real Mazda photo in a gold
// frame with two floating badges on the right, and an animated gold lane line along the bottom.
// Layout and copy follow the first <section> of docs/mockup/Main.dc.html.
import { Image } from 'astro:assets';
import carFront from '../assets/images/real/car-front.jpg';
import { site, cta } from '../data/site';

const facts = [
  { value: `${site.experience.drivingYears} yrs`, label: 'driving experience' },
  { value: site.languageCodes.join(' · '), label: 'languages taught' },
  { value: '7 days', label: 'a week' },
];
---

<section class="hero relative overflow-hidden">
  <div class="relative mx-auto flex max-w-[1200px] flex-col gap-12 px-4 pb-[72px] pt-10 sm:px-6 sm:pt-16 lg:flex-row lg:items-center">
    <div class="min-w-0 flex-1">
      <p class="text-[13px] font-bold tracking-[0.14em] text-accent-text">
        LONDON, ONTARIO &amp; SURROUNDING AREAS
      </p>
      <h1 class="mb-[18px] mt-4 text-[2.5rem] font-extrabold leading-[1.05] tracking-[-0.01em] sm:text-5xl xl:text-6xl">
        Learn to drive with confidence. <span class="grad">Get <span class="whitespace-nowrap">road-ready</span> with Skillmasters.</span>
      </h1>
      <p class="mb-[30px] max-w-[540px] text-lg leading-relaxed text-fg-soft sm:text-[19px]">
        Personalized, patient lessons and an MTO-approved Beginner Driver Education (BDE) course, with
        pickup across {site.areas.slice(0, -1).join(', ')} and {site.areas.at(-1)}.
      </p>

      <div class="flex flex-wrap gap-3.5">
        <a
          href={cta.href}
          class="rounded-full bg-gold px-7 py-[17px] font-bold text-ink shadow-[0_8px_28px_var(--glow)] transition hover:-translate-y-0.5 hover:brightness-95"
        >
          Book a lesson <span aria-hidden="true">→</span>
        </a>
        <a
          href="#finder"
          class="rounded-full border-2 border-fg px-[26px] py-[15px] font-bold text-fg transition hover:-translate-y-0.5 hover:bg-fg hover:text-surface-raised"
        >
          Find my package
        </a>
      </div>

      <dl class="mt-9 flex flex-wrap gap-7">
        {facts.map((f) => (
          <div class="flex flex-col-reverse">
            <dt class="text-[13px] text-fg-muted">{f.label}</dt>
            <dd class="font-display text-[26px] font-extrabold">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-[560px] min-w-0 flex-1">
      <div class="relative aspect-square overflow-hidden rounded-[28px] border-[3px] border-gold shadow-[0_30px_70px_#00000040]">
        <Image
          src={carFront}
          quality={70}
          alt="The Skillmasters Mazda 3 training car with its lion roof sign"
          widths={[400, 560, 720, 898]}
          sizes="(min-width: 1024px) 560px, calc(100vw - 32px)"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 size-full object-cover object-[50%_45%]"
        />
      </div>

      <div class="absolute -bottom-5 left-3 flex items-center gap-3 rounded-[18px] border border-border bg-surface-raised px-[18px] py-3.5 shadow-[0_16px_40px_#00000026] lg:-bottom-[22px] lg:-left-[22px]">
        <span class="flex size-10 items-center justify-center rounded-full bg-gold font-extrabold text-ink" aria-hidden="true">✓</span>
        <span>
          <strong class="block">Dual-brake safety</strong>
          <span class="text-[13px] text-fg-muted">Every lesson, every student</span>
        </span>
      </div>

      <p class="absolute -top-[18px] right-3 rounded-full bg-ink px-4 py-2.5 text-sm font-extrabold text-[#F0C45A] shadow-[0_12px_30px_#00000033] lg:-right-3.5">
        MTO Licence #{site.licences.bde}
      </p>
    </div>
  </div>

  <!-- Road with a moving gold lane line (static under reduced motion). -->
  <div class="absolute inset-x-0 bottom-0 h-4 bg-road" aria-hidden="true"></div>
  <div class="lane absolute inset-x-0 bottom-[5px] h-[5px]" aria-hidden="true"></div>
</section>

<style>
  .hero {
    background: var(--hero-bg);
  }
  .lane {
    background: repeating-linear-gradient(90deg, #f4d27a 0 60px, transparent 60px 120px);
    animation: lane 1.2s linear infinite;
  }
  @keyframes lane {
    to {
      background-position: -120px 0;
    }
  }
</style>
