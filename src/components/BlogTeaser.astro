---
// "Free guides & practice": the G1 practice test card (black) + 2 article cards.
// Copy and layout from docs/mockup/Main.dc.html. The two articles are read from the blog
// collection (src/content/blog/), so titles and links always match the real articles.
import { getEntry } from 'astro:content';
import BlogCard from './BlogCard.astro';

const featured = ['how-to-get-your-g1-in-ontario', 'g2-road-test-checklist-london'];
const posts = (await Promise.all(featured.map((id) => getEntry('blog', id)))).filter((p) => p !== undefined);
---

<section aria-labelledby="guides-title" class="mx-auto max-w-[1200px] px-4 py-16 sm:px-6 sm:py-[88px]">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div class="reveal">
      <p class="text-[13px] font-bold tracking-[0.14em] text-accent-text">LEARN BEFORE YOU DRIVE</p>
      <h2 id="guides-title" class="mt-2.5 text-[2rem] font-extrabold tracking-[-0.01em] sm:text-[40px]">
        Free guides &amp; practice
      </h2>
    </div>
    <a href="/blog" class="font-bold text-accent-text hover:underline">All articles <span aria-hidden="true">→</span></a>
  </div>

  <ul class="grid gap-[22px] md:grid-cols-3">
    <li class="reveal">
      <a
        href="/g1-practice-test"
        class="lift flex h-full min-h-[220px] flex-col gap-3 rounded-[22px] bg-ink p-7 text-[#F5EFE3] dark:bg-black dark:ring-1 dark:ring-border"
      >
        <span class="text-xs font-extrabold tracking-[0.12em] text-[#F0C45A]">INTERACTIVE</span>
        <h3 class="text-2xl font-extrabold leading-tight">Free G1 practice test</h3>
        <span class="leading-relaxed text-[#C9BFAE]">
          6 real-style questions on Ontario road rules and signs. See your score instantly.
        </span>
        <span class="mt-auto font-bold text-[#F0C45A]">Start the test <span aria-hidden="true">→</span></span>
      </a>
    </li>
    {posts.map((post) => (
      <li class="reveal"><BlogCard post={post} compact /></li>
    ))}
  </ul>
</section>
