---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import WhoWeServe from '../components/WhoWeServe.astro';
import PackageFinder from '../components/PackageFinder.astro';
import Packages from '../components/Packages.astro';
import WhySkillmasters from '../components/WhySkillmasters.astro';
import PassWall from '../components/PassWall.astro';
import FAQ from '../components/FAQ.astro';
import BlogTeaser from '../components/BlogTeaser.astro';
import CtaBand from '../components/CtaBand.astro';
import { drivingSchoolSchema, websiteSchema } from '../data/schema';
---

<BaseLayout
  fullTitle="Skillmasters Driving School | Driving Lessons & BDE in London, ON"
  jsonLd={[drivingSchoolSchema(), websiteSchema()]}
  description="Driving lessons and an MTO-approved BDE course in London, Ontario, with pickup across London, St. Thomas, Thorndale and Dorchester."
>
  <Hero />
  <TrustStrip />
  <WhoWeServe />
  <PackageFinder />
  <Packages />
  <WhySkillmasters />
  <PassWall />
  <FAQ />
  <BlogTeaser />
  <CtaBand />
</BaseLayout>
