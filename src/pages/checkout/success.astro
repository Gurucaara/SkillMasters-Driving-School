---
// Where Stripe sends people back after paying (step 4 · Schedule): /checkout/success?session_id=cs_…
// The script asks /api/checkout-status whether that session is really paid, and only then shows
// "Payment received" with the package and amount. Without a session id, or if Stripe says it isn't
// paid, the page stays neutral and never claims a payment. No made-up time slots: the Cal.com
// scheduler goes in the marked spot once Rahul's account exists. noindex.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import { site } from '../../data/site';
---

<BaseLayout title="Thank you" description="Thanks for booking with Skillmasters Driving School." noindex>
  <PageBanner crumb="Checkout" eyebrow="STEP 4 · SCHEDULE" title="Thank you! Let’s pick your first lesson." />

  <section class="border-b border-border bg-section">
    <div class="mx-auto max-w-[760px] px-4 py-12 sm:px-6 sm:py-16">
      <div class="rounded-[24px] border border-border bg-surface-raised p-6 sm:p-9">
        <div class="flex items-start gap-4">
          <span data-paid-icon hidden class="flex size-12 flex-none items-center justify-center rounded-full bg-good text-xl font-extrabold text-on-good" aria-hidden="true">✓</span>
          <div role="status" aria-live="polite">
            <h2 data-paid-title class="text-2xl font-extrabold">Thanks for booking with us</h2>
            <p data-paid-text class="mt-1 text-fg-muted">If you’ve just paid, Stripe emails your receipt. Keep it for your records.</p>
          </div>
        </div>

        <h3 class="mt-8 text-lg font-extrabold">What happens next</h3>
        <ol class="mt-3 list-decimal space-y-2 pl-5 text-fg-soft marker:font-bold marker:text-accent-text">
          <li>Rahul will text or WhatsApp you within a day ({site.hours}) to book your first lesson.</li>
          <li>We'll confirm your pickup spot in {site.areas.join(', ').replace(/, ([^,]*)$/, ' or $1')}.</li>
          <li>You'll get a reminder the day before your lesson.</li>
        </ol>

        <!-- Cal.com scheduler goes here once Rahul's Cal.com account is connected. -->
        <div class="mt-8 rounded-2xl border border-dashed border-border bg-section p-5">
          <p class="font-semibold">Prefer to arrange it now?</p>
          <div class="mt-3 flex flex-wrap gap-3">
            <a href={site.whatsapp} rel="noopener" target="_blank" class="rounded-full bg-gold px-5 py-3 font-bold text-ink hover:brightness-95">WhatsApp us</a>
            <a href={site.phone.href} class="rounded-full border-2 border-fg px-5 py-2.5 font-bold text-fg hover:bg-fg hover:text-surface-raised">Call {site.phone.display}</a>
          </div>
        </div>

        <p class="mt-8 text-sm text-fg-muted">
          <a href="/" class="font-semibold text-accent-text underline">Back to home</a>
          <span aria-hidden="true"> · </span>
          <a href="/g1-practice-test" class="font-semibold text-accent-text underline">Warm up with the G1 practice test</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Confirm the payment with Stripe (through our server) before saying it went through.
  const id = new URLSearchParams(location.search).get('session_id');
  const title = document.querySelector<HTMLElement>('[data-paid-title]');
  const text = document.querySelector<HTMLElement>('[data-paid-text]');
  const icon = document.querySelector<HTMLElement>('[data-paid-icon]');
  if (id && title && text && icon) {
    fetch(`/api/checkout-status?session_id=${encodeURIComponent(id)}`)
      .then((r) => (r.ok ? r.json() : null))
      .then((s: { paid?: boolean; status?: string; packageName?: string | null; total?: string | null } | null) => {
        if (s?.paid) {
          title.textContent = `Payment received: ${s.total ?? ''}`.trim();
          text.textContent = `${s.packageName ?? 'Your package'} · Stripe has emailed your receipt. Keep it for your records.`;
          icon.hidden = false;
        } else if (s && s.status === 'unpaid') {
          title.textContent = 'Your payment is still processing';
          text.textContent = 'Some payment methods take a little longer. You’ll get an email from Stripe once it goes through.';
        }
      })
      .catch(() => {
        /* keep the neutral message */
      });
  }
</script>
