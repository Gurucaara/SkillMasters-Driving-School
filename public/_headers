# Security headers for every page (Cloudflare Workers static assets).
# The main Content-Security-Policy (scripts, styles, images…) is a <meta> tag Astro writes
# into each page with hashes (see astro.config.mjs). This header adds the rules that only
# work as an HTTP header, like frame-ancestors.
/*
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), payment=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

/manifest.webmanifest
  Content-Type: application/manifest+json

# Always check for a new service worker so updates reach visitors quickly.
/sw.js
  Cache-Control: no-cache
